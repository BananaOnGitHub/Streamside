--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios ]
install-name:    '/usr/lib/libSystem.B.dylib'
current-version: 1336
exports:
  - targets:         [ arm64-ios ]
    symbols:         [ ___memcpy_chk, ___stderrp, __Block_copy, __Block_release,
                       __Block_object_assign, __Block_object_dispose, __NSConcreteStackBlock,
                       __NSConcreteGlobalBlock, __tlv_bootstrap, _dladdr,
                       __availability_version_check, _sys_icache_invalidate,
                       _arc4random_uniform, _bzero,
                       _calloc, _clock_gettime, _dlopen, _dlsym, _dispatch_queue_create, _fprintf, _free,
                       _fwrite, _malloc, _memchr, _memcpy, _memmove,
                       _pthread_mutex_lock, _pthread_mutex_unlock, _qsort, _realloc,
                       _snprintf, _strcat, _strchr, _strcmp, _strdup, _strlen,
                       _strnlen, _strncmp, _strrchr, _strstr, _strtok_r, _strtoll, _strtoul, _vsnprintf,
                       _strtoull, _time,
                       dyld_stub_binder ]
...
